{
  "expo": {
    "name": "GiggiFi",
    "slug": "Giggifi-Mobile-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "giggifimobileapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.giggifi.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.giggifi.app",
      "adaptiveIcon": {
        "backgroundColor": "#0c0710",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0710",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#ec4899",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GiggiFi uses your photos to set your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GiggiFi uses your location to find Quick Moments artists near you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d55b67ad-f4e7-4063-b805-f677fd0ec6f4",
      "fallbackToCacheTimeout": 3000
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d55b67ad-f4e7-4063-b805-f677fd0ec6f4"
      }
    },
    "owner": "thesachinmusic"
  }
}
