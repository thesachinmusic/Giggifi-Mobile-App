{
  "expo": {
    "name": "GiggiFi",
    "slug": "Giggifi-Mobile-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "giggifimobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.giggifi.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.giggifi.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0710",
          "image": "./assets/images/giggifi-logo-cropped.png",
          "imageWidth": 280
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#ec4899"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GiggiFi uses your photos to set your profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GiggiFi uses your location to find Quick Moments artists near you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d55b67ad-f4e7-4063-b805-f677fd0ec6f4"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d55b67ad-f4e7-4063-b805-f677fd0ec6f4"
      }
    },
    "owner": "thesachinmusic"
  }
}
